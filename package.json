{
  "name": "weekly-walkthrough",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "preflight": "node --env-file=.env.local scripts/preflight.mjs",
    "demo": "node --env-file=.env.local scripts/demo.mjs",
    "purge": "node --env-file=.env.local scripts/purge-photos.mjs",
    "reset-close": "node --env-file=.env.local scripts/reset-close.mjs",
    "report": "node --env-file=.env.local scripts/report.mjs",
    "set-items": "node --env-file=.env.local scripts/set-items.mjs",
    "predev": "node --env-file=.env.local scripts/preflight.mjs || true",
    "prebuild": "node --env-file=.env.local scripts/preflight.mjs 2>/dev/null || true",
    "check-rollup": "tsc src/lib/rollup-math.ts --outDir .rollup-check --module esnext --target es2022 --moduleResolution bundler && node scripts/check-rollup.mjs",
    "test-venue": "node --env-file=.env.local scripts/test-venue.mjs",
    "cleared": "node --env-file=.env.local scripts/cleared.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
