# Copy to .env.local and fill in. Names only here — never commit a value.

# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Admin PIN, 6 digits. Comma-separate for more than one.
ADMIN_PIN=

# Thursday 4pm Pacific. 0=Sun … 6=Sat, and 0–23.
DEADLINE_DAY=4
DEADLINE_HOUR=16

# Bearer token for the read-only /api/scores export.
# Unset means the endpoint is off, not open.
SCORES_API_TOKEN=
